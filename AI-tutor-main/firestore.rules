/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All user-generated
 * data, including study plans and progress reports, is stored in subcollections under that
 * user's unique document. This ensures that users can only ever access their own data.
 *
 * Data Structure: Data is organized hierarchically, starting with a top-level `/users`
 * collection. Each user's data is nested under `/users/{userId}`, creating a private data
 * tree for each user. This includes `/users/{userId}/studyPlans`, `/users/{userId}/quizAttempts`,
 * and `/users/{userId}/cryptographyChatHistory`.
 *
 * Key Security Decisions:
 * - Default Deny: All access is denied by default.
 * - Strict Ownership: Users can only access their own data.
 * - No User Listing: Users cannot list documents from the root `/users` collection.
 * - Path-Based Security: Authorization is based on the user's UID and document path.
 */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's ID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if an existing document belongs to the authenticated user.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates a new User profile document.
     */
    function userProfileIsValidOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Prevents the User profile ID from being changed.
     */
    function userProfileIsValidOnUpdate() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Validates a new Study Plan document.
     */
    function studyPlanIsValidOnCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Prevents the Study Plan userId from being changed.
     */
    function studyPlanIsValidOnUpdate() {
      return request.resource.data.userId == resource.data.userId;
    }

    /**
     * Validates a new Progress Report document.
     */
    function progressReportIsValidOnCreate(userId, studyPlanId) {
      return request.resource.data.userId == userId
          && request.resource.data.studyPlanId == studyPlanId;
    }

    /**
     * Prevents Progress Report ownership fields from being changed.
     */
    function progressReportIsValidOnUpdate() {
      return request.resource.data.userId == resource.data.userId
          && request.resource.data.studyPlanId == resource.data.studyPlanId;
    }

    /**
     * Validates a new Cryptography Chat Message document.
     */
    function cryptographyMessageIsValidOnCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Prevents the Cryptography Chat Message userId from being changed.
     */
    function cryptographyMessageIsValidOnUpdate() {
      return request.resource.data.userId == resource.data.userId;
    }


    // -------------------------------------------------------------------------
    // USER COLLECTION
    // -------------------------------------------------------------------------

    match /users/{userId} {

      // User profile
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && userProfileIsValidOnCreate(userId);

      allow update: if isExistingOwner(userId)
        && userProfileIsValidOnUpdate();

      allow delete: if isExistingOwner(userId);


      // -----------------------------------------------------------------------
      // STUDY PLANS
      // -----------------------------------------------------------------------

      match /studyPlans/{studyPlanId} {

        allow get: if isOwner(userId);

        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && studyPlanIsValidOnCreate(userId);

        allow update: if isExistingOwner(userId)
          && studyPlanIsValidOnUpdate();

        allow delete: if isExistingOwner(userId);


        // ---------------------------------------------------------------------
        // PROGRESS REPORTS
        // ---------------------------------------------------------------------

        match /progressReports/{progressReportId} {

          allow get: if isOwner(userId);

          allow list: if isOwner(userId);

          allow create: if isOwner(userId)
            && progressReportIsValidOnCreate(
              userId,
              studyPlanId
            );

          allow update: if isExistingOwner(userId)
            && progressReportIsValidOnUpdate();

          allow delete: if isExistingOwner(userId);
        }
      }


      // -----------------------------------------------------------------------
      // QUIZ ATTEMPTS
      // -----------------------------------------------------------------------

      /**
       * Stores completed quiz attempts and results.
       *
       * Path:
       * /users/{userId}/quizAttempts/{attemptId}
       *
       * Only the authenticated user who owns the parent user document
       * can read or modify these quiz results.
       */
      match /quizAttempts/{attemptId} {

        allow get: if isOwner(userId);

        allow list: if isOwner(userId);

        allow create: if isOwner(userId);

        allow update: if isOwner(userId);

        allow delete: if isOwner(userId);
      }


      // -----------------------------------------------------------------------
      // CRYPTOGRAPHY CHAT HISTORY
      // -----------------------------------------------------------------------

      /**
       * Manages a user's private cryptography chat history.
       *
       * Path:
       * /users/{userId}/cryptographyChatHistory/{messageId}
       */
      match /cryptographyChatHistory/{messageId} {

        allow get: if isOwner(userId);

        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && cryptographyMessageIsValidOnCreate(userId);

        allow update: if isExistingOwner(userId)
          && cryptographyMessageIsValidOnUpdate();

        allow delete: if isExistingOwner(userId);
      }
    }
  }
}
